# Unity .gitignore Template
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Last synced: 2025-12-18
# License: CC0-1.0
#
# This template is maintained from the github/gitignore repository
# and distributed under Creative Commons Zero v1.0 Universal license.

# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/UnityProject/[Ll]ibrary/
/UnityProject/[Tt]emp/
/UnityProject/[Oo]bj/
/UnityProject/[Bb]uild/
/UnityProject/[Bb]uilds/
/UnityProject/[Ll]ogs/
/UnityProject/[Uu]ser[Ss]ettings/
/UnityProject/.idea/*
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be committed to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/UnityProject/[Mm]emoryCaptures/

# Recordings can get excessive in size
/UnityProject/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/UnityProject/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
/UnityProject/.vs/

# Gradle cache directory
/UnityProject/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/UnityProject/UnityProject/ExportedObj/
/UnityProject/UnityProject/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
/UnityProject/sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
/UnityProject/crashlytics-build.properties

# TestRunner generated files
/UnityProject/InitTestScene*.unity*

# Addressables default ignores, before user customizations
/UnityProject/ServerData
/UnityProject/[Aa]ssets/StreamingAssets/aa*
/UnityProject/[Aa]ssets/AddressableAssetsData/link.xml*
/UnityProject/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/UnityProject/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/UnityProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/UnityProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/UnityProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/UnityProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/UnityProject/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# -------------------------------------------------------
# iOS / Swift / Xcode
# Source: https://github.com/github/gitignore/blob/main/Swift.gitignore
# -------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode
build/
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
*.xcuserstate
*.xcscmblueprint

# Xcode Simulator
*.xcrun

# Swift Package Manager
.build/
.swiftpm/
**/checkouts/
**/artifacts/

# CocoaPods
Pods/
*.xcworkspace
!NativeiOSApp/NativeiOSApp.xcworkspace

# Carthage
Carthage/Build/

# Accio
Dependencies/
.accio/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code coverage
*.gcno
*.gcda

# Instruments
*.trace

# Archives
*.ipa
*.dSYM.zip
*.dSYM
